From 6561ff4c0bf06074280dd401c90b64d5cca699b1 Mon Sep 17 00:00:00 2001
From: Silvio Traversaro <silvio@traversaro.it>
Date: Mon, 17 Aug 2026 09:36:55 +0200
Subject: [PATCH] Do not pass 4.2.0 to find_package(OpenCV ..) for OpenCV 5
 compatibility

---
 src/modules/ergoCubEmotions/CMakeLists.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/modules/ergoCubEmotions/CMakeLists.txt b/src/modules/ergoCubEmotions/CMakeLists.txt
index b9db20b0..3f09aeb6 100644
--- a/src/modules/ergoCubEmotions/CMakeLists.txt
+++ b/src/modules/ergoCubEmotions/CMakeLists.txt
@@ -7,7 +7,11 @@
 project(ergoCubEmotions)
 cmake_minimum_required(VERSION 3.12)
 
-find_package(OpenCV 4.2.0 REQUIRED)
+find_package(OpenCV REQUIRED)
+
+if(OpenCV_VERSION VERSION_LESS 4.2.0)
+  message(FATAL_ERROR "OpenCV 4.2.0 or newer is required, found ${OpenCV_VERSION}")
+endif()
 
 set(doc_files ${PROJECT_NAME}.xml)
 yarp_add_idl(IDL_GEN_FILES idl.thrift)
